# Porta do servidor (padrão 3000)
PORT=3000

# MySQL: HOST, USER e PASSWORD obrigatórios (o código não tem valor padrão); DATABASE padrão bmerp_000000 (o banco do ERP)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Chave que assina os tokens de sessão. Sem ela, uma chave aleatória é gerada a cada
# reinício do servidor e todos precisam entrar de novo.
SESSION_SECRET=

# Vercel: senha das rotinas agendadas (vercel.json › crons). A Vercel a envia como
# "Authorization: Bearer CRON_SECRET"; sem ela, /api/cron/* recusa tudo.
CRON_SECRET=

# Endereço do BM-Master (lançador de módulos): /api/entrar só volta para ele em caso de erro. Vários separados por
# vírgula; vazio = só localhost
MASTER_URL=
